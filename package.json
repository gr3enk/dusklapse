{
    "name": "dusklapse",
    "private": true,
    "version": "0.2.0",
    "license": "MIT OR Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check"
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-geolocation": "^2.3.2",
        "@tauri-apps/plugin-log": "^2.9.0",
        "@tauri-apps/plugin-opener": "^2",
        "clsx": "^2.1.1",
        "lucide-react": "^1.27.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.4",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.5.3"
}
