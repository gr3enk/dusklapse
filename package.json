{
    "name": "dusklapse",
    "private": true,
    "version": "0.4.2",
    "license": "MIT OR Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check"
    },
    "dependencies": {
        "@rive-app/react-webgl2": "^4.37.1",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-geolocation": "^2.5.0",
        "@tauri-apps/plugin-log": "^2.10.1",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "clsx": "^2.1.1",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@11.22.0"
}
