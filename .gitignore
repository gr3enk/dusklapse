# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Node / pnpm
# ---------------------------------------------------------------------------
node_modules
.pnpm-store/

# ---------------------------------------------------------------------------
# Frontend build output
# ---------------------------------------------------------------------------
dist
dist-ssr
*.local
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
src-tauri/target/
**/*.rs.bk

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
# Generated ACL/permission schemas - rebuilt on every build.
src-tauri/gen/schemas/

# NOTE: src-tauri/gen/apple and src-tauri/gen/android ARE committed on purpose.
# They hold the Xcode/Gradle project config (bundle id, entitlements, plist
# entries) that you customize by hand. Each already ships its own .gitignore
# for the build artifacts inside it.

# ---------------------------------------------------------------------------
# iOS / Xcode
# ---------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/
*.ipa
*.dSYM
*.dSYM.zip

# CocoaPods - the Podfile is generated by Tauri, the resolved tree is derived.
Pods/
Podfile.lock

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
src-tauri/gen/android/.gradle/
src-tauri/gen/android/local.properties
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/captures/
*.apk
*.aab

# ---------------------------------------------------------------------------
# Signing material & secrets - never commit these
# ---------------------------------------------------------------------------
*.pem
*.p12
*.cer
*.keystore
*.jks
*.mobileprovision
*.provisionprofile

.env
.env.*
!.env.example

# Canon CCAPI activation files are bound to one specific camera body.
*.ccapi

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
.claude/settings.local.json
