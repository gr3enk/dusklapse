<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS-only Info.plist additions.

  Tauri merges this file into the generated
  gen/apple/dusklapse_iOS/Info.plist at build time. Edit this file, never the
  generated one - `tauri ios init` overwrites that.
-->
<plist version="1.0">
<dict>
	<!--
	  The name shown under the icon and in the app switcher.
	  iOS falls back to CFBundleName when this is absent, which productName already
	  sets correctly - this is here so the user-facing name is stated outright rather
	  than inherited, and so it survives a future rename past CFBundleName's 15
	  character convention.
	-->
	<key>CFBundleDisplayName</key>
	<string>Dusklapse</string>

	<!--
	  Required since iOS 14 for *any* traffic to the local network. Without it,
	  connections to a camera fail silently: no error, no prompt, just timeouts.
	  iOS shows this string in the permission dialog, so it has to explain the
	  benefit to the user rather than describe the API.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dusklapse needs access to your local network to find and control your camera over Wi-Fi.</string>

	<!--
	  Bonjour service types must be declared up front; iOS will not browse for a
	  type that is not listed here. Canon bodies with CCAPI enabled advertise
	  over HTTP, Nikon and Sony over PTP-IP.

	  Manual IP entry does not need these, but it does still need the
	  NSLocalNetworkUsageDescription above.
	-->
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_ptp._tcp</string>
	</array>

	<!--
	  Required before iOS will show a location prompt at all - CoreLocation refuses the
	  request outright when this key is missing. "WhenInUse" and not "Always": the
	  position is only read while someone is setting up a shot, never in the background.

	  The string says what it is for, because a location prompt in a camera app looks
	  like tracking unless it explains itself.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dusklapse uses your location to work out when sunset, twilight and night begin, so it can darken the timelapse as the sky does.</string>

	<!--
	  Answers the export compliance question once here instead of on every upload.
	
	  `false` is the accurate answer, not a convenient one: `reqwest` is pulled in with
	  `default-features = false` and only the `json` feature, so no TLS backend is compiled
	  in at all - `rustls`, `native-tls` and `openssl` appear zero times in Cargo.lock. The
	  app speaks plaintext HTTP to cameras on a private network and fetches nothing from the
	  internet; the frontend is embedded in the binary rather than loaded over the wire.
	
	  Encryption that iOS itself provides would be exempt anyway. This key states that there
	  is none beyond it.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  Camera APIs are plaintext HTTP on a private network and always will be.
	  All camera I/O goes through reqwest in Rust, which has its own stack and is
	  not subject to App Transport Security - this exemption is only so the
	  WebView can reach the Vite dev server during `tauri ios dev`.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
